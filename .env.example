# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed vars to the client.

# Supabase — real authentication (src/context/AuthContext.tsx). Free tier, no card.
# Create a project at https://supabase.com/dashboard, then Project Settings > API.
# The anon key is safe to expose client-side by design (Supabase's security
# boundary is Row Level Security policies, not this key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq — used for text simplification (src/lib/simplify.ts). Free tier, no card.
# https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Sarvam AI — swap in for src/lib/speech.ts once Web Speech API baseline works.
# https://www.sarvam.ai/apis
VITE_SARVAM_API_KEY=

# Bhashini — swap in for wider Indian-language STT/TTS/NMT coverage.
# https://bhashini.gitbook.io/bhashini-apis
VITE_BHASHINI_API_KEY=
